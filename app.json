{
  "expo": {
    "name": "Flun",
    "slug": "flun",
    "version": "1.0.0",
    "description": "Créez des histoires magiques et personnalisées avec des illustrations uniques générées par IA. Parfait pour les enfants... et les grands enfants !",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#38b6ff"
        }
      ],
      "expo-web-browser"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1821"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flun.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Flun utilise la caméra pour personnaliser votre photo de profil.",
        "NSPhotoLibraryUsageDescription": "Flun accède à vos photos pour personnaliser votre profil et vos histoires."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1821"
      },
      "package": "com.flun.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "8d26f2b7-d22d-48a7-9636-52f155c3bd7e"
      }
    },
    "owner": "chris4"
  }
}
